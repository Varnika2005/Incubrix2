{
  "name": "incubrix-visibility-engine",
  "version": "1.0.0",
  "private": true,
  "description": "IncuBrix AEO, SEO & GEO Visibility Engine — Growth Engineer Assessment (Option 3)",
  "type": "module",
  "scripts": {
    "setup": "npm install && python -m engine.cli init --live-audit",
    "dev": "concurrently -k -n API,WEB -c cyan,blue \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx server/index.ts",
    "dev:web": "vite --port 5173",
    "start": "python -m engine.cli init && concurrently -k -n API,WEB -c cyan,blue \"tsx server/index.ts\" \"vite --port 5173\"",
    "start:prod": "python -m engine.cli init && tsx server/index.ts",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "engine": "python -m engine.cli",
    "engine:init": "python -m engine.cli init --live-audit",
    "engine:audit": "python -m engine.cli audit --target https://www.incubrix.com",
    "engine:run": "python -m engine.cli run-visibility --mode test --limit 15",
    "engine:export": "python -m engine.cli export-all",
    "engine:report": "python -m engine.cli generate-report",
    "test": "npm run test:python && npm run test:unit",
    "test:python": "python -m unittest discover -s tests/python -p \"test_*.py\" -v",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run test:python && npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@tailwindcss/vite": "^4.0.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
