# ==============================================================================
# IncuBrix AEO / SEO / GEO Visibility Engine — Environment Configuration
# Copy this file to .env and fill in any available credentials.
# Core features (Technical SEO Auditor, Question Pipeline, Content Studio,
# Citation Research, Test-Mode Visibility Runs, Manual Evidence Ingestion,
# CSV/Workbook Exports, and Weekly Reports) work WITHOUT paid API keys.
# ==============================================================================

# Server & Database Configuration
PORT=3001
VITE_API_URL=http://localhost:3001
SQLITE_DB_PATH=./data/incubrix.db
TARGET_WEBSITE_URL=https://www.incubrix.com

# Search Engine Visibility Providers (Optional — enables live Automated SERP/AIO collection)
# Google Custom Search JSON API (Programmable Search Engine)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# SerpApi (Optional — enables Google Answer Box, AI Overview & Organic Rank extraction)
SERPAPI_API_KEY=

# AI Assistant / Answer Engine Providers (Optional — enables live LLM mention & citation checks)
# OpenAI (ChatGPT / GPT-4o Search)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API (Gemini 2.5 Flash with Google Search Grounding)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Perplexity Sonar API (Citation-native Answer Engine)
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# Anthropic Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Engine Execution Settings
DEFAULT_MARKETS=US,IN,GB
REQUEST_TIMEOUT_SECONDS=15
MAX_RETRIES=2
